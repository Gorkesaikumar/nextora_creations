# =============================================================================
# Nextora Mini POS — Environment Configuration (.env.example)
# =============================================================================
# Both VITE_* and NEXT_PUBLIC_* variable prefixes are supported by pos/vite.config.js.
# Leave optional values empty when the release or external service is not yet live.
# =============================================================================

# Canonical production URL of the POS website
VITE_SITE_URL="https://pos.nextoracreations.co.in"
# NEXT_PUBLIC_SITE_URL="https://pos.nextoracreations.co.in"

# Google Play Store URL
# If empty, the Android page and download card will display "Coming Soon on Google Play"
# When published, set the full listing URL: https://play.google.com/store/apps/details?id=...
VITE_GOOGLE_PLAY_URL=""
# NEXT_PUBLIC_GOOGLE_PLAY_URL=""

# Official Windows Desktop installer URL (.exe / .msi)
# If empty, the download page displays "Coming Soon / Contact Support"
VITE_WINDOWS_DOWNLOAD_URL=""
# NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=""

# Customer Support contact details
VITE_SUPPORT_EMAIL="support@nextoracreations.co.in"
VITE_SUPPORT_PHONE="+91 76749 81970"
VITE_WHATSAPP_URL="https://wa.me/917674981970?text=Hi%20Nextora%20Team%2C%20I%20am%20interested%20in%20Nextora%20Mini%20POS."

# Google Analytics GA4 Measurement ID (e.g. G-XXXXXXXXXX)
# Disabled by default. Only set this if you explicitly want to enable GA4 on the POS site.
VITE_GA_MEASUREMENT_ID=""
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""

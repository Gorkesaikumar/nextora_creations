    "vite": "^8.1.5",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@studio-freight/lenis": "^1.0.42",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",

  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:pos": "npm --prefix pos run dev",
    "build:pos": "npm --prefix pos run build",
    "preview:pos": "npm --prefix pos run preview",
    "optimize": "node scripts/optimize.js",
    "dev:api": "node --env-file-if-exists=.env server/local.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "db:maintenance": "node --env-file-if-exists=.env scripts/maintenance.js",
    "test": "node scripts/test.js",
    "test:unit": "node --test tests/domain.test.js",
    "test:ui": "node scripts/test.js --ui",
    "build:functions": "netlify functions:build --src netlify/functions --functions .netlify/functions-build",
    "certificate:signature": "node --env-file-if-exists=.env scripts/configure-signature.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gorkesaikumar/nextora_creations.git"

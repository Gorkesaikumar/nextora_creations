    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.5.4",
    "jsqr": "^1.4.0",
    "netlify-cli": "^26.2.0",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3",

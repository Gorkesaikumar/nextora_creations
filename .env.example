# Local PostgreSQL via `docker compose up -d db` (change for hosted PostgreSQL).
DATABASE_URL=postgresql://nextora:nextora-local-only@127.0.0.1:54329/nextora
APP_URL=http://localhost:5173
CERTIFICATE_BASE_URL=https://nextoracreations.co.in
# Generate for production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Used locally by certificate:signature CLI (then clear), or as a local-only override.
# Company-authorized PNG, 20x10 to 2000x1000 px, max 500 KB. Never put in public/.
CERTIFICATE_SIGNATURE_PATH=
# Optional small base64 override. Production should use private DB signature storage.
CERTIFICATE_SIGNATURE_BASE64=
# One-time CLI bootstrap only. Remove ADMIN_PASSWORD immediately afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
